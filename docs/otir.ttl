                         :AveragePrice 30 ;
                         :Name "Restaurant Gourmet Madrid" ;
                         rdfs:comment "Restaurant in Madrid, specialized in high-end Japanese cuisine." ;
                         rdfs:label "Restaurant Gourmet Madrid" .


