          :HasLocation :HotelRoyalPamplona ,
                       :RestaurantDeliciaPamplona ;
          :Location "42.8169,-1.6444" ;
          :Name "Pamplona" ;
          rdfs:comment "City of Pamplona, internationally known for the San Fermín festival." ;
          rdfs:label "Pamplona" .


