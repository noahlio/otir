:N1 rdf:type swrl:Variable .

:N2 rdf:type swrl:Variable .

:Ta1 rdf:type swrl:Variable .

:Ta2 rdf:type swrl:Variable .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "Rule that assigns the best hotel of the city. If the hotel is the only one in the city, it doesn't count." ;
   rdfs:label "BestHotelRule" ;
   rdf:type swrl:Imp ;
   swrl:body [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:ClassAtom ;
                           swrl:classPredicate schema:Hotel ;
                           swrl:argument1 :H1
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                      swrl:propertyPredicate :LocatedInCity ;
                                      swrl:argument1 :H1 ;
                                      swrl:argument2 :C
                                    ] ;
                          rdf:rest [ rdf:type swrl:AtomList ;
                                     rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                                                 swrl:propertyPredicate :Rating ;
                                                 swrl:argument1 :H1 ;
                                                 swrl:argument2 :R1
                                               ] ;
                                     rdf:rest [ rdf:type swrl:AtomList ;
                                                rdf:first [ rdf:type swrl:ClassAtom ;
                                                            swrl:classPredicate schema:Hotel ;
                                                            swrl:argument1 :H2
                                                          ] ;
                                                rdf:rest [ rdf:type swrl:AtomList ;
                                                           rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                                       swrl:propertyPredicate :LocatedInCity ;
                                                                       swrl:argument1 :H2 ;
                                                                       swrl:argument2 :C
                                                                     ] ;
                                                           rdf:rest [ rdf:type swrl:AtomList ;
                                                                      rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                                                                                  swrl:propertyPredicate :Rating ;
                                                                                  swrl:argument1 :H2 ;
                                                                                  swrl:argument2 :R2
                                                                                ] ;
                                                                      rdf:rest [ rdf:type swrl:AtomList ;
                                                                                 rdf:first [ rdf:type swrl:BuiltinAtom ;
                                                                                             swrl:builtin swrlb:greaterThan ;
                                                                                             swrl:arguments ( :R1
                                                                                                              :R2
                                                                                                            )
                                                                                           ] ;
                                                                                 rdf:rest rdf:nil
                                                                               ]
                                                                    ]
                                                         ]
                                              ]
                                   ]
                        ]
             ] ;
   swrl:head [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                           swrl:propertyPredicate :BestHotel ;
                           swrl:argument1 :H1 ;
                           swrl:argument2 :C
                         ] ;
               rdf:rest rdf:nil
             ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "Rule that indicates the rest of the places in the same city as the consulted place." ;
   rdfs:label "SameCityRule" ;
   rdf:type swrl:Imp ;
   swrl:body [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:ClassAtom ;
                           swrl:classPredicate schema:Place ;
                           swrl:argument1 :P1
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:ClassAtom ;
                                      swrl:classPredicate schema:Place ;
                                      swrl:argument1 :P2
                                    ] ;
                          rdf:rest [ rdf:type swrl:AtomList ;
                                     rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                                                 swrl:propertyPredicate :Name ;
                                                 swrl:argument1 :P1 ;
                                                 swrl:argument2 :N1
                                               ] ;
                                     rdf:rest [ rdf:type swrl:AtomList ;
                                                rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                                                            swrl:propertyPredicate :Name ;
                                                            swrl:argument1 :P2 ;
                                                            swrl:argument2 :N2
                                                          ] ;
                                                rdf:rest [ rdf:type swrl:AtomList ;
                                                           rdf:first [ rdf:type swrl:BuiltinAtom ;
                                                                       swrl:builtin swrlb:notEqual ;
                                                                       swrl:arguments ( :N1
                                                                                        :N2
                                                                                      )
                                                                     ] ;
                                                           rdf:rest [ rdf:type swrl:AtomList ;
                                                                      rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                                                  swrl:propertyPredicate :LocatedInCity ;
                                                                                  swrl:argument1 :P1 ;
                                                                                  swrl:argument2 :C
                                                                                ] ;
                                                                      rdf:rest [ rdf:type swrl:AtomList ;
                                                                                 rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                                                             swrl:propertyPredicate :LocatedInCity ;
                                                                                             swrl:argument1 :P2 ;
                                                                                             swrl:argument2 :C
                                                                                           ] ;
                                                                                 rdf:rest rdf:nil
                                                                               ]
                                                                    ]
                                                         ]
                                              ]
                                   ]
                        ]
             ] ;
   swrl:head [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                           swrl:propertyPredicate :SameCity ;
                           swrl:argument1 :P1 ;
                           swrl:argument2 :P2
                         ] ;
               rdf:rest rdf:nil
             ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
