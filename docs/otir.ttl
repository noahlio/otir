:RestaurantTradicioToledo rdf:type owl:NamedIndividual ,
                                   :MexicanCuisine ;
                          :AveragePrice 46 ;
                          :Name "Restaurant Tradicio Toledo" ;
                          rdfs:comment "Restaurant in Toledo, serving traditional Mexican cuisine." ;
                          rdfs:label "Restaurant Tradicio Toledo" .


###  https://noah.dev/ontologies/otir/SanSebastian
:SanSebastian rdf:type owl:NamedIndividual ,
                       schema:City ;
              :Location "43.3183,-1.9812" ;
              :Name "Sant Sebastià" ;
              rdfs:comment "City of Sant Sebastià, known for its beaches and culinary excellence." ;
              rdfs:label "San Sebastian" .


###  https://noah.dev/ontologies/otir/Saragossa
:Saragossa rdf:type owl:NamedIndividual ,
                    schema:City ;
           :HasLocation :CastellSaragossa ;
           :Location "41.6488,-0.8891" ;
           :Name "Saragossa" ;
           rdfs:comment "City of Saragossa, known for its historical heritage and cultural events." ;
           rdfs:label "Saragossa" .


###  https://noah.dev/ontologies/otir/Sevilla
:Sevilla rdf:type owl:NamedIndividual ,
                  schema:City ;
         :HasLocation :CarnavalSevilla ,
                      :CastellSevilla ,
                      :CatedralSevilla ,
                      :HotelDelMarSevilla ,
                      :HotelVistaSevilla ;
         :Location "37.3886,-5.9823" ;
