###  https://noah.dev/ontologies/otir/HotelRoyalMalaga
:HotelRoyalMalaga rdf:type owl:NamedIndividual ,
                           :TouristicHotel ;
                  :Name "Hotel Royal Málaga" ;
                  :NightPrice 175 ;
                  :Rating 4.6 ;
                  :StarRating 5 ;
                  rdfs:comment "Hotel in Málaga, a five-star accommodation near the coast." ;
                  rdfs:label "Hotel Royal Málaga" .


###  https://noah.dev/ontologies/otir/HotelRoyalPamplona
:HotelRoyalPamplona rdf:type owl:NamedIndividual ,
                             :LuxuryHotel ;
                    :Name "Hotel Royal Pamplona" ;
                    :NightPrice 56 ;
                    :Rating 3.9 ;
                    :StarRating 3 ;
                    rdfs:comment "Hotel in Pamplona, a comfortable option for visitors to the city." ;
                    rdfs:label "Hotel Royal Pamplona" .


###  https://noah.dev/ontologies/otir/HotelVistaSevilla
:HotelVistaSevilla rdf:type owl:NamedIndividual ,
                            :BeachHotel ;
                   :Name "Hotel Vista Sevilla" ;
                   :NightPrice 278 ;
                   :Rating 4.7 ;
                   :StarRating 4 ;
                   rdfs:comment "Hotel in Sevilla, a four-star hotel located close to the beach." ;
                   rdfs:label "Hotel Vista Sevilla" .


###  https://noah.dev/ontologies/otir/Madrid
:Madrid rdf:type owl:NamedIndividual ,
                 schema:City ;
        :HasLocation :MuseuMadrid ,
                     :RestaurantGourmetMadrid ;
        :Location "40.4168,-3.7038" ;
        :Name "Madrid" ;
        rdfs:comment "City of Madrid, the capital of Spain, known for its museums and lively culture." ;
        rdfs:label "Madrid" .


###  https://noah.dev/ontologies/otir/MuseuMadrid
:MuseuMadrid rdf:type owl:NamedIndividual ,
                      :Museum ;
             :Name "Museu Madrid" ;
             :Rating 3.7 ;
             rdfs:comment "Tourist attraction in Madrid, a museum showcasing local and international art." ;
             rdfs:label "Museu Madrid" .


###  https://noah.dev/ontologies/otir/Málaga
:Málaga rdf:type owl:NamedIndividual ,
                 schema:City ;
        :HasLocation :HotelRoyalMalaga ,
                     :RestaurantDeliciaMalaga ;
        :Location "36.7213,-4.4210" ;
        :Name "Màlaga" ;
        rdfs:comment "City of Málaga, a coastal city known for its beaches and historical sites." ;
        rdfs:label "Málaga" .


###  https://noah.dev/ontologies/otir/Pamplona
:Pamplona rdf:type owl:NamedIndividual ,
