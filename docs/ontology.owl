<?xml version="1.0"?>
<rdf:RDF xmlns="https://noah.dev/ontologies/otir#"
     xml:base="https://noah.dev/ontologies/otir"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:otir="https://noah.dev/ontologies/otir/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:elements="https://purl.org/dc/elements/1.1/">
    <owl:Ontology rdf:about="https://noah.dev/ontologies/otir">
        <dc:creator>Noah</dc:creator>
        <dc:description>This ontology describes tourism-related information such as hotels, restaurants, events, and tourist attractions in cities.</dc:description>
        <dc:license>https://opensource.org/licenses/MIT</dc:license>
        <dc:rights>MIT License</dc:rights>
        <dc:title>Tourism Information Retrieval Ontology</dc:title>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/elements/1.1/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
    


    <!-- http://purl.org/dc/elements/1.1/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/description"/>
    


    <!-- http://purl.org/dc/elements/1.1/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/license"/>
    


    <!-- http://purl.org/dc/elements/1.1/rights -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/rights"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->


    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- http://www.w3.org/2002/07/owl#symmetricProperty -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#symmetricProperty"/>
    


    <!-- https://purl.org/dc/elements/1.1/description -->


    <owl:AnnotationProperty rdf:about="https://purl.org/dc/elements/1.1/description"/>
    


    <!-- https://purl.org/dc/elements/1.1/license -->


    <owl:AnnotationProperty rdf:about="https://purl.org/dc/elements/1.1/license"/>
    


    <!-- https://purl.org/dc/elements/1.1/rights -->


    <owl:AnnotationProperty rdf:about="https://purl.org/dc/elements/1.1/rights"/>
    


    <!-- https://purl.org/dc/elements/1.1/title -->


    <owl:AnnotationProperty rdf:about="https://purl.org/dc/elements/1.1/title"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://noah.dev/ontologies/otir/BestHotel -->


    <owl:ObjectProperty rdf:about="https://noah.dev/ontologies/otir/BestHotel">
        <owl:inverseOf rdf:resource="https://noah.dev/ontologies/otir/HasBestHotel"/>
        <rdfs:domain rdf:resource="https://schema.org/Hotel"/>
        <rdfs:range rdf:resource="https://schema.org/City"/>
        <rdfs:comment>Relates a hotel to the city where it has the highest rating among all hotels.</rdfs:comment>
        <rdfs:label>Best Hotel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://noah.dev/ontologies/otir/BestTouristAttraction -->


    <owl:ObjectProperty rdf:about="https://noah.dev/ontologies/otir/BestTouristAttraction">
        <owl:inverseOf rdf:resource="https://noah.dev/ontologies/otir/HasBestTouristAttraction"/>
        <rdfs:domain rdf:resource="https://schema.org/TouristAttraction"/>
        <rdfs:range rdf:resource="https://schema.org/City"/>
        <rdfs:comment>Relates a tourist attraction to the city where it stands out with the highest rating or interest among all attractions.</rdfs:comment>
        <rdfs:label>Best Tourist Attraction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://noah.dev/ontologies/otir/HasBestHotel -->


    <owl:ObjectProperty rdf:about="https://noah.dev/ontologies/otir/HasBestHotel">
        <rdfs:domain rdf:resource="https://schema.org/City"/>
        <rdfs:range rdf:resource="https://schema.org/Hotel"/>
        <rdfs:comment>Relates a city to the hotel with the highest rating within it.</rdfs:comment>
        <rdfs:label>Has Best Hotel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://noah.dev/ontologies/otir/HasBestTouristAttraction -->


    <owl:ObjectProperty rdf:about="https://noah.dev/ontologies/otir/HasBestTouristAttraction">
        <rdfs:domain rdf:resource="https://schema.org/City"/>
        <rdfs:range rdf:resource="https://schema.org/TouristAttraction"/>
        <rdfs:comment>Relates a city to its best-rated or most significant tourist attraction.</rdfs:comment>
        <rdfs:label>Has Best Tourist Attraction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://noah.dev/ontologies/otir/HasLocation -->


    <owl:ObjectProperty rdf:about="https://noah.dev/ontologies/otir/HasLocation">
        <owl:inverseOf rdf:resource="https://noah.dev/ontologies/otir/LocatedInCity"/>
        <rdfs:domain rdf:resource="https://schema.org/City"/>
        <rdfs:range rdf:resource="https://schema.org/Place"/>
        <rdfs:comment>Relates a city to the entities (TouristAttraction, Hotel, Restaurant, Event) located within it.</rdfs:comment>
        <rdfs:label>Has Location</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://noah.dev/ontologies/otir/LocatedInCity -->


    <owl:ObjectProperty rdf:about="https://noah.dev/ontologies/otir/LocatedInCity">
        <rdfs:domain rdf:resource="https://schema.org/Place"/>
        <rdfs:range rdf:resource="https://schema.org/City"/>
        <rdfs:comment>Relates any entity (TouristAttraction, Hotel, Restaurant, Event) to the city in which it is located.</rdfs:comment>
        <rdfs:label>Located In City</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://noah.dev/ontologies/otir/SameCity -->


    <owl:ObjectProperty rdf:about="https://noah.dev/ontologies/otir/SameCity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://schema.org/Place"/>
        <rdfs:range rdf:resource="https://schema.org/Place"/>
        <rdfs:comment>Relates two places that are located in the same city.</rdfs:comment>
        <rdfs:label>Same City</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://noah.dev/ontologies/otir/AveragePrice -->


    <owl:DatatypeProperty rdf:about="https://noah.dev/ontologies/otir/AveragePrice">
        <rdfs:domain rdf:resource="https://schema.org/Restaurant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Represents the average price of a meal at a restaurant.</rdfs:comment>
        <rdfs:label>Average Price</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://noah.dev/ontologies/otir/Date -->


    <owl:DatatypeProperty rdf:about="https://noah.dev/ontologies/otir/Date">
        <rdfs:domain rdf:resource="https://schema.org/Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>Specifies the date and time when an event occurs.</rdfs:comment>
        <rdfs:label>Date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://noah.dev/ontologies/otir/Location -->


    <owl:DatatypeProperty rdf:about="https://noah.dev/ontologies/otir/Location">
        <rdfs:domain rdf:resource="https://schema.org/City"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Represents the location of a city.</rdfs:comment>
        <rdfs:label>Location</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://noah.dev/ontologies/otir/Name -->


    <owl:DatatypeProperty rdf:about="https://noah.dev/ontologies/otir/Name">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://schema.org/City"/>
                    <rdf:Description rdf:about="https://schema.org/Place"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Represents the name of a tourist attraction, city, event, hotel, or restaurant.</rdfs:comment>
        <rdfs:label>Name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://noah.dev/ontologies/otir/NightPrice -->


    <owl:DatatypeProperty rdf:about="https://noah.dev/ontologies/otir/NightPrice">
        <rdfs:domain rdf:resource="https://schema.org/Hotel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Specifies the price per night for a hotel room.</rdfs:comment>
        <rdfs:label>Night Price</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://noah.dev/ontologies/otir/Rating -->


    <owl:DatatypeProperty rdf:about="https://noah.dev/ontologies/otir/Rating">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://schema.org/Hotel"/>
                    <rdf:Description rdf:about="https://schema.org/Restaurant"/>
                    <rdf:Description rdf:about="https://schema.org/TouristAttraction"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Represents the rating of a tourist attraction, hotel, or restaurant.</rdfs:comment>
        <rdfs:label>Rating</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://noah.dev/ontologies/otir/StarRating -->


    <owl:DatatypeProperty rdf:about="https://noah.dev/ontologies/otir/StarRating">
        <rdfs:domain rdf:resource="https://schema.org/Hotel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Specifies the star rating of a hotel.</rdfs:comment>
        <rdfs:label>Star Rating</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2002/07/owl#Thing -->


    <rdf:Description rdf:about="http://www.w3.org/2002/07/owl#Thing">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://noah.dev/ontologies/otir/Name"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
    </rdf:Description>
    


    <!-- https://noah.dev/ontologies/otir/AndalusianCuisine -->


    <owl:Class rdf:about="https://noah.dev/ontologies/otir/AndalusianCuisine">
        <rdfs:subClassOf rdf:resource="https://schema.org/Restaurant"/>
        <rdfs:comment>Restaurants specialized in Andalusian cuisine.</rdfs:comment>
        <rdfs:label>Andalusian Cuisine</rdfs:label>
    </owl:Class>
    


    <!-- https://noah.dev/ontologies/otir/Beach -->


    <owl:Class rdf:about="https://noah.dev/ontologies/otir/Beach">
        <rdfs:subClassOf rdf:resource="https://schema.org/TouristAttraction"/>
        <rdfs:comment>Tourist attraction related to beaches and coastal areas.</rdfs:comment>
        <rdfs:label>Beach</rdfs:label>
    </owl:Class>
    


    <!-- https://noah.dev/ontologies/otir/BeachHotel -->


    <owl:Class rdf:about="https://noah.dev/ontologies/otir/BeachHotel">
        <rdfs:subClassOf rdf:resource="https://schema.org/Hotel"/>
        <rdfs:comment>Hotel located near the beach or with direct beach access.</rdfs:comment>
        <rdfs:label>Beach Hotel</rdfs:label>
    </owl:Class>
    


    <!-- https://noah.dev/ontologies/otir/BusinessHotel -->


    <owl:Class rdf:about="https://noah.dev/ontologies/otir/BusinessHotel">
        <rdfs:subClassOf rdf:resource="https://schema.org/Hotel"/>
        <rdfs:comment>Hotel oriented towards business travelers and corporate events.</rdfs:comment>
        <rdfs:label>Business Hotel</rdfs:label>
    </owl:Class>
    


    <!-- https://noah.dev/ontologies/otir/Cultural -->


    <owl:Class rdf:about="https://noah.dev/ontologies/otir/Cultural">
        <rdfs:subClassOf rdf:resource="https://schema.org/TouristAttraction"/>
        <rdfs:comment>Tourist attraction related to various cultural activities or spaces.</rdfs:comment>
        <rdfs:label>Cultural</rdfs:label>
    </owl:Class>
    


    <!-- https://noah.dev/ontologies/otir/CulturalEvent -->


    <owl:Class rdf:about="https://noah.dev/ontologies/otir/CulturalEvent">
        <rdfs:subClassOf rdf:resource="https://schema.org/Event"/>
        <rdfs:comment>Cultural events such as festivals, fairs, or performances.</rdfs:comment>
        <rdfs:label>Cultural Event</rdfs:label>
    </owl:Class>
    


    <!-- https://noah.dev/ontologies/otir/GastronomicEvent -->


    <owl:Class rdf:about="https://noah.dev/ontologies/otir/GastronomicEvent">
        <rdfs:subClassOf rdf:resource="https://schema.org/Event"/>
        <rdfs:comment>Events related to gastronomy or food tasting.</rdfs:comment>
        <rdfs:label>Gastronomic Event</rdfs:label>
    </owl:Class>
    


    <!-- https://noah.dev/ontologies/otir/ItalianCuisine -->


    <owl:Class rdf:about="https://noah.dev/ontologies/otir/ItalianCuisine">
        <rdfs:subClassOf rdf:resource="https://schema.org/Restaurant"/>
        <rdfs:comment>Restaurants specialized in Italian cuisine.</rdfs:comment>
        <rdfs:label>Italian Cuisine</rdfs:label>
    </owl:Class>
    


    <!-- https://noah.dev/ontologies/otir/JapaneseCuisine -->


    <owl:Class rdf:about="https://noah.dev/ontologies/otir/JapaneseCuisine">
        <rdfs:subClassOf rdf:resource="https://schema.org/Restaurant"/>
        <rdfs:comment>Restaurants specialized in Japanese cuisine.</rdfs:comment>
        <rdfs:label>Japanese Cuisine</rdfs:label>
    </owl:Class>
    


    <!-- https://noah.dev/ontologies/otir/LuxuryHotel -->


    <owl:Class rdf:about="https://noah.dev/ontologies/otir/LuxuryHotel">
        <rdfs:subClassOf rdf:resource="https://schema.org/Hotel"/>
        <rdfs:comment>High-end hotel offering luxury services.</rdfs:comment>
        <rdfs:label>Luxury Hotel</rdfs:label>
    </owl:Class>
    


    <!-- https://noah.dev/ontologies/otir/MediterraneanCuisine -->


    <owl:Class rdf:about="https://noah.dev/ontologies/otir/MediterraneanCuisine">
        <rdfs:subClassOf rdf:resource="https://schema.org/Restaurant"/>
        <rdfs:comment>Restaurants specialized in Mediterranean cuisine.</rdfs:comment>
        <rdfs:label>Mediterranean Cuisine</rdfs:label>
    </owl:Class>
    


    <!-- https://noah.dev/ontologies/otir/MexicanCuisine -->


    <owl:Class rdf:about="https://noah.dev/ontologies/otir/MexicanCuisine">
        <rdfs:subClassOf rdf:resource="https://schema.org/Restaurant"/>
        <rdfs:comment>Restaurants specialized in Mexican cuisine.</rdfs:comment>
        <rdfs:label>Mexican Cuisine</rdfs:label>
    </owl:Class>
    


    <!-- https://noah.dev/ontologies/otir/Monument -->


    <owl:Class rdf:about="https://noah.dev/ontologies/otir/Monument">
        <rdfs:subClassOf rdf:resource="https://schema.org/TouristAttraction"/>
        <rdfs:comment>Historical or symbolic structure of cultural interest.</rdfs:comment>
        <rdfs:label>Monument</rdfs:label>
    </owl:Class>
    


    <!-- https://noah.dev/ontologies/otir/Museum -->


    <owl:Class rdf:about="https://noah.dev/ontologies/otir/Museum">
        <rdfs:subClassOf rdf:resource="https://schema.org/TouristAttraction"/>
        <rdfs:comment>Tourist attraction focused on cultural or artistic exhibitions.</rdfs:comment>
        <rdfs:label>Museum</rdfs:label>
    </owl:Class>
    


    <!-- https://noah.dev/ontologies/otir/MusicEvent -->


    <owl:Class rdf:about="https://noah.dev/ontologies/otir/MusicEvent">
        <rdfs:subClassOf rdf:resource="https://schema.org/Event"/>
        <rdfs:comment>Events centered around musical performances or concerts.</rdfs:comment>
        <rdfs:label>Music Event</rdfs:label>
    </owl:Class>
    


    <!-- https://noah.dev/ontologies/otir/Park -->


    <owl:Class rdf:about="https://noah.dev/ontologies/otir/Park">
        <rdfs:subClassOf rdf:resource="https://schema.org/TouristAttraction"/>
        <rdfs:comment>Green spaces intended for leisure and relaxation of visitors.</rdfs:comment>
        <rdfs:label>Park</rdfs:label>
    </owl:Class>
    


    <!-- https://noah.dev/ontologies/otir/RuralHotel -->


    <owl:Class rdf:about="https://noah.dev/ontologies/otir/RuralHotel">
        <rdfs:subClassOf rdf:resource="https://schema.org/Hotel"/>
        <rdfs:comment>Hotel located in natural or rural environments.</rdfs:comment>
        <rdfs:label>Rural Hotel</rdfs:label>
    </owl:Class>
    


    <!-- https://noah.dev/ontologies/otir/SportEvent -->


    <owl:Class rdf:about="https://noah.dev/ontologies/otir/SportEvent">
        <rdfs:subClassOf rdf:resource="https://schema.org/Event"/>
        <rdfs:comment>Events related to sports activities.</rdfs:comment>
        <rdfs:label>Sport Event</rdfs:label>
    </owl:Class>
    


    <!-- https://noah.dev/ontologies/otir/TechnologicalEvent -->


    <owl:Class rdf:about="https://noah.dev/ontologies/otir/TechnologicalEvent">
        <rdfs:subClassOf rdf:resource="https://schema.org/Event"/>
        <rdfs:comment>Events related to technology, innovation, or science.</rdfs:comment>
        <rdfs:label>Technological Event</rdfs:label>
    </owl:Class>
    


    <!-- https://noah.dev/ontologies/otir/TouristicHotel -->


    <owl:Class rdf:about="https://noah.dev/ontologies/otir/TouristicHotel">
        <rdfs:subClassOf rdf:resource="https://schema.org/Hotel"/>
        <rdfs:comment>Hotel mainly aimed at leisure travelers.</rdfs:comment>
        <rdfs:label>Touristic Hotel</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/City -->


    <owl:Class rdf:about="https://schema.org/City">
        <rdfs:comment>Municipalities or geographic locations within the ontology.</rdfs:comment>
        <rdfs:label>City</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/Event -->


    <owl:Class rdf:about="https://schema.org/Event">
        <rdfs:subClassOf rdf:resource="https://schema.org/Place"/>
        <rdfs:comment>Activities or events that take place in a city and are intended for the public.</rdfs:comment>
        <rdfs:label>Event</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/Hotel -->


    <owl:Class rdf:about="https://schema.org/Hotel">
        <rdfs:subClassOf rdf:resource="https://schema.org/Place"/>
        <rdfs:comment>Establishments offering accommodation to travelers and tourists.</rdfs:comment>
        <rdfs:label>Hotel</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/Place -->


    <owl:Class rdf:about="https://schema.org/Place">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://noah.dev/ontologies/otir/LocatedInCity"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://schema.org/City"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A general class representing any physical location, such as a hotel, restaurant, attraction, or event venue, which is associated with a specific city.</rdfs:comment>
        <rdfs:label>Place</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/Restaurant -->


    <owl:Class rdf:about="https://schema.org/Restaurant">
        <rdfs:subClassOf rdf:resource="https://schema.org/Place"/>
        <rdfs:comment>Establishments offering food and beverage services.</rdfs:comment>
        <rdfs:label>Restaurant</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/TouristAttraction -->


    <owl:Class rdf:about="https://schema.org/TouristAttraction">
        <rdfs:subClassOf rdf:resource="https://schema.org/Place"/>
        <rdfs:comment>Tourist places of interest that can be visited by users.</rdfs:comment>
        <rdfs:label>Tourist Attraction</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://noah.dev/ontologies/otir/Barcelona -->


    <owl:NamedIndividual rdf:about="https://noah.dev/ontologies/otir/Barcelona">
        <rdf:type rdf:resource="https://schema.org/City"/>
        <otir:Location>41.3874,2.1686</otir:Location>
        <otir:Name>Barcelona</otir:Name>
        <rdfs:comment>City of Barcelona, known for its architecture, culture, and Mediterranean coast.</rdfs:comment>
        <rdfs:label>Barcelona</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://noah.dev/ontologies/otir/Bilbao -->


    <owl:NamedIndividual rdf:about="https://noah.dev/ontologies/otir/Bilbao">
        <rdf:type rdf:resource="https://schema.org/City"/>
        <otir:HasLocation rdf:resource="https://noah.dev/ontologies/otir/CongresBilbao"/>
        <otir:HasLocation rdf:resource="https://noah.dev/ontologies/otir/HotelRoyalBilbao"/>
        <otir:Location>43.2630,-2.9350</otir:Location>
        <otir:Name>Bilbao</otir:Name>
        <rdfs:comment>City of Bilbao, famous for the Guggenheim Museum and Basque culture.</rdfs:comment>
        <rdfs:label>Bilbao</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://noah.dev/ontologies/otir/Cadis -->


    <owl:NamedIndividual rdf:about="https://noah.dev/ontologies/otir/Cadis">
        <rdf:type rdf:resource="https://schema.org/City"/>
        <otir:HasLocation rdf:resource="https://noah.dev/ontologies/otir/CarnavalCadis"/>
        <otir:HasLocation rdf:resource="https://noah.dev/ontologies/otir/CastellCadis"/>
        <otir:HasLocation rdf:resource="https://noah.dev/ontologies/otir/CongresCadis"/>
        <otir:Location>36.5297,-6.2920</otir:Location>
        <otir:Name>Cadis</otir:Name>
        <rdfs:comment>City of Cadis, a historic port city in southwestern Spain.</rdfs:comment>
        <rdfs:label>Cadis</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://noah.dev/ontologies/otir/CarnavalCadis -->


    <owl:NamedIndividual rdf:about="https://noah.dev/ontologies/otir/CarnavalCadis">
        <rdf:type rdf:resource="https://noah.dev/ontologies/otir/SportEvent"/>
        <otir:Date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-19</otir:Date>
        <otir:Name>Carnaval Cadis</otir:Name>
        <rdfs:comment>Event in Cadis, a traditional and colorful carnival celebration.</rdfs:comment>
