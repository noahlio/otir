#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( <https://schema.org/City>
                <https://schema.org/Event>
                <https://schema.org/Hotel>
                <https://schema.org/Restaurant>
                <https://schema.org/TouristAttraction>
              )
] .


#################################################################
#    Rules
#################################################################

<https://noah.dev/ontologies/otir/H1> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://noah.dev/ontologies/otir/C> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://noah.dev/ontologies/otir/R1> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://noah.dev/ontologies/otir/H2> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://noah.dev/ontologies/otir/R2> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://noah.dev/ontologies/otir/P1> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://noah.dev/ontologies/otir/P2> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://noah.dev/ontologies/otir/N1> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://noah.dev/ontologies/otir/N2> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://noah.dev/ontologies/otir/Ta1> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

<https://noah.dev/ontologies/otir/Ta2> rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "Rule that assigns the best hotel of the city. If the hotel is the only one in the city, it doesn't count." ;
   rdfs:label "BestHotelRule" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> <https://schema.org/Hotel> ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> <https://noah.dev/ontologies/otir/H1>
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#propertyPredicate> <https://noah.dev/ontologies/otir/LocatedInCity> ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> <https://noah.dev/ontologies/otir/H1> ;
                                                                  <http://www.w3.org/2003/11/swrl#argument2> <https://noah.dev/ontologies/otir/C>
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#propertyPredicate> <https://noah.dev/ontologies/otir/Rating> ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> <https://noah.dev/ontologies/otir/H1> ;
                                                                             <http://www.w3.org/2003/11/swrl#argument2> <https://noah.dev/ontologies/otir/R1>
                                                                           ] ;
                                                                 rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                            rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                                        <http://www.w3.org/2003/11/swrl#classPredicate> <https://schema.org/Hotel> ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument1> <https://noah.dev/ontologies/otir/H2>
                                                                                      ] ;
                                                                            rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                                       rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                                                   <http://www.w3.org/2003/11/swrl#propertyPredicate> <https://noah.dev/ontologies/otir/LocatedInCity> ;
                                                                                                   <http://www.w3.org/2003/11/swrl#argument1> <https://noah.dev/ontologies/otir/H2> ;
                                                                                                   <http://www.w3.org/2003/11/swrl#argument2> <https://noah.dev/ontologies/otir/C>
                                                                                                 ] ;
                                                                                       rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                                                  rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                                                                                                              <http://www.w3.org/2003/11/swrl#propertyPredicate> <https://noah.dev/ontologies/otir/Rating> ;
                                                                                                              <http://www.w3.org/2003/11/swrl#argument1> <https://noah.dev/ontologies/otir/H2> ;
                                                                                                              <http://www.w3.org/2003/11/swrl#argument2> <https://noah.dev/ontologies/otir/R2>
                                                                                                            ] ;
                                                                                                  rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                                                             rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#BuiltinAtom> ;
                                                                                                                         <http://www.w3.org/2003/11/swrl#builtin> <http://www.w3.org/2003/11/swrlb#greaterThan> ;
                                                                                                                         <http://www.w3.org/2003/11/swrl#arguments> ( <https://noah.dev/ontologies/otir/R1>
                                                                                                                                                                      <https://noah.dev/ontologies/otir/R2>
                                                                                                                                                                    )
                                                                                                                       ] ;
                                                                                                             rdf:rest rdf:nil
                                                                                                           ]
                                                                                                ]
                                                                                     ]
                                                                          ]
                                                               ]
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> <https://noah.dev/ontologies/otir/BestHotel> ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> <https://noah.dev/ontologies/otir/H1> ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> <https://noah.dev/ontologies/otir/C>
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "Rule that indicates the rest of the places in the same city as the consulted place." ;
   rdfs:label "SameCityRule" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> <https://schema.org/Place> ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> <https://noah.dev/ontologies/otir/P1>
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#classPredicate> <https://schema.org/Place> ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> <https://noah.dev/ontologies/otir/P2>
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#propertyPredicate> <https://noah.dev/ontologies/otir/Name> ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> <https://noah.dev/ontologies/otir/P1> ;
                                                                             <http://www.w3.org/2003/11/swrl#argument2> <https://noah.dev/ontologies/otir/N1>
                                                                           ] ;
                                                                 rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                            rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                                                                                        <http://www.w3.org/2003/11/swrl#propertyPredicate> <https://noah.dev/ontologies/otir/Name> ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument1> <https://noah.dev/ontologies/otir/P2> ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument2> <https://noah.dev/ontologies/otir/N2>
                                                                                      ] ;
                                                                            rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                                       rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#BuiltinAtom> ;
                                                                                                   <http://www.w3.org/2003/11/swrl#builtin> <http://www.w3.org/2003/11/swrlb#notEqual> ;
                                                                                                   <http://www.w3.org/2003/11/swrl#arguments> ( <https://noah.dev/ontologies/otir/N1>
                                                                                                                                                <https://noah.dev/ontologies/otir/N2>
                                                                                                                                              )
                                                                                                 ] ;
                                                                                       rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                                                  rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                                                              <http://www.w3.org/2003/11/swrl#propertyPredicate> <https://noah.dev/ontologies/otir/LocatedInCity> ;
                                                                                                              <http://www.w3.org/2003/11/swrl#argument1> <https://noah.dev/ontologies/otir/P1> ;
                                                                                                              <http://www.w3.org/2003/11/swrl#argument2> <https://noah.dev/ontologies/otir/C>
                                                                                                            ] ;
                                                                                                  rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                                                             rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                                                                         <http://www.w3.org/2003/11/swrl#propertyPredicate> <https://noah.dev/ontologies/otir/LocatedInCity> ;
                                                                                                                         <http://www.w3.org/2003/11/swrl#argument1> <https://noah.dev/ontologies/otir/P2> ;
