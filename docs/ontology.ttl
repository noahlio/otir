@prefix : <https://noah.dev/ontologies/otir#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://noah.dev/ontologies/otir#> .

<https://noah.dev/ontologies/otir> rdf:type owl:Ontology ;
                                    <http://purl.org/dc/elements/1.1/creator> "Noah" ;
                                    <http://purl.org/dc/elements/1.1/description> "This ontology describes tourism-related information such as hotels, restaurants, events, and tourist attractions in cities." ;
                                    <http://purl.org/dc/elements/1.1/license> "https://opensource.org/licenses/MIT" ;
                                    <http://purl.org/dc/elements/1.1/rights> "MIT License" ;
                                    <http://purl.org/dc/elements/1.1/title> "Tourism Information Retrieval Ontology" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/creator
<http://purl.org/dc/elements/1.1/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
<http://purl.org/dc/elements/1.1/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/license
<http://purl.org/dc/elements/1.1/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/rights
<http://purl.org/dc/elements/1.1/rights> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
<http://purl.org/dc/elements/1.1/title> rdf:type owl:AnnotationProperty .


###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#symmetricProperty
owl:symmetricProperty rdf:type owl:AnnotationProperty .


###  https://purl.org/dc/elements/1.1/description
<https://purl.org/dc/elements/1.1/description> rdf:type owl:AnnotationProperty .


###  https://purl.org/dc/elements/1.1/license
<https://purl.org/dc/elements/1.1/license> rdf:type owl:AnnotationProperty .


###  https://purl.org/dc/elements/1.1/rights
<https://purl.org/dc/elements/1.1/rights> rdf:type owl:AnnotationProperty .


###  https://purl.org/dc/elements/1.1/title
<https://purl.org/dc/elements/1.1/title> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://noah.dev/ontologies/otir/BestHotel
<https://noah.dev/ontologies/otir/BestHotel> rdf:type owl:ObjectProperty ;
                                             owl:inverseOf <https://noah.dev/ontologies/otir/HasBestHotel> ;
                                             rdfs:domain <https://schema.org/Hotel> ;
                                             rdfs:range <https://schema.org/City> ;
                                             rdfs:comment "Relates a hotel to the city where it has the highest rating among all hotels." ;
                                             rdfs:label "Best Hotel" .


###  https://noah.dev/ontologies/otir/BestTouristAttraction
<https://noah.dev/ontologies/otir/BestTouristAttraction> rdf:type owl:ObjectProperty ;
                                                         owl:inverseOf <https://noah.dev/ontologies/otir/HasBestTouristAttraction> ;
                                                         rdfs:domain <https://schema.org/TouristAttraction> ;
                                                         rdfs:range <https://schema.org/City> ;
                                                         rdfs:comment "Relates a tourist attraction to the city where it stands out with the highest rating or interest among all attractions." ;
                                                         rdfs:label "Best Tourist Attraction" .


###  https://noah.dev/ontologies/otir/HasBestHotel
<https://noah.dev/ontologies/otir/HasBestHotel> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <https://schema.org/City> ;
                                                rdfs:range <https://schema.org/Hotel> ;
                                                rdfs:comment "Relates a city to the hotel with the highest rating within it." ;
                                                rdfs:label "Has Best Hotel" .


###  https://noah.dev/ontologies/otir/HasBestTouristAttraction
<https://noah.dev/ontologies/otir/HasBestTouristAttraction> rdf:type owl:ObjectProperty ;
                                                            rdfs:domain <https://schema.org/City> ;
                                                            rdfs:range <https://schema.org/TouristAttraction> ;
                                                            rdfs:comment "Relates a city to its best-rated or most significant tourist attraction." ;
                                                            rdfs:label "Has Best Tourist Attraction" .


###  https://noah.dev/ontologies/otir/HasLocation
<https://noah.dev/ontologies/otir/HasLocation> rdf:type owl:ObjectProperty ;
                                               owl:inverseOf <https://noah.dev/ontologies/otir/LocatedInCity> ;
                                               rdfs:domain <https://schema.org/City> ;
                                               rdfs:range <https://schema.org/Place> ;
                                               rdfs:comment "Relates a city to the entities (TouristAttraction, Hotel, Restaurant, Event) located within it." ;
                                               rdfs:label "Has Location" .


###  https://noah.dev/ontologies/otir/LocatedInCity
<https://noah.dev/ontologies/otir/LocatedInCity> rdf:type owl:ObjectProperty ;
                                                 rdfs:domain <https://schema.org/Place> ;
                                                 rdfs:range <https://schema.org/City> ;
                                                 rdfs:comment "Relates any entity (TouristAttraction, Hotel, Restaurant, Event) to the city in which it is located." ;
                                                 rdfs:label "Located In City" .


###  https://noah.dev/ontologies/otir/SameCity
<https://noah.dev/ontologies/otir/SameCity> rdf:type owl:ObjectProperty ,
                                                     owl:SymmetricProperty ;
                                            rdfs:domain <https://schema.org/Place> ;
                                            rdfs:range <https://schema.org/Place> ;
                                            rdfs:comment "Relates two places that are located in the same city." ;
                                            rdfs:label "Same City" .


#################################################################
#    Data properties
#################################################################

###  https://noah.dev/ontologies/otir/AveragePrice
<https://noah.dev/ontologies/otir/AveragePrice> rdf:type owl:DatatypeProperty ;
                                                rdfs:domain <https://schema.org/Restaurant> ;
                                                rdfs:range xsd:integer ;
                                                rdfs:comment "Represents the average price of a meal at a restaurant." ;
                                                rdfs:label "Average Price" .


###  https://noah.dev/ontologies/otir/Date
<https://noah.dev/ontologies/otir/Date> rdf:type owl:DatatypeProperty ;
                                        rdfs:domain <https://schema.org/Event> ;
                                        rdfs:range xsd:date ;
                                        rdfs:comment "Specifies the date and time when an event occurs." ;
                                        rdfs:label "Date" .


###  https://noah.dev/ontologies/otir/Location
<https://noah.dev/ontologies/otir/Location> rdf:type owl:DatatypeProperty ;
                                            rdfs:domain <https://schema.org/City> ;
                                            rdfs:range xsd:string ;
                                            rdfs:comment "Represents the location of a city." ;
                                            rdfs:label "Location" .


###  https://noah.dev/ontologies/otir/Name
<https://noah.dev/ontologies/otir/Name> rdf:type owl:DatatypeProperty ;
                                        rdfs:domain [ rdf:type owl:Class ;
                                                      owl:unionOf ( <https://schema.org/City>
                                                                    <https://schema.org/Place>
                                                                  )
                                                    ] ;
                                        rdfs:range xsd:string ;
                                        rdfs:comment "Represents the name of a tourist attraction, city, event, hotel, or restaurant." ;
                                        rdfs:label "Name" .


###  https://noah.dev/ontologies/otir/NightPrice
<https://noah.dev/ontologies/otir/NightPrice> rdf:type owl:DatatypeProperty ;
                                              rdfs:domain <https://schema.org/Hotel> ;
                                              rdfs:range xsd:integer ;
                                              rdfs:comment "Specifies the price per night for a hotel room." ;
                                              rdfs:label "Night Price" .


###  https://noah.dev/ontologies/otir/Rating
<https://noah.dev/ontologies/otir/Rating> rdf:type owl:DatatypeProperty ;
                                          rdfs:domain [ rdf:type owl:Class ;
                                                        owl:unionOf ( <https://schema.org/Hotel>
                                                                      <https://schema.org/Restaurant>
                                                                      <https://schema.org/TouristAttraction>
                                                                    )
                                                      ] ;
                                          rdfs:range xsd:decimal ;
                                          rdfs:comment "Represents the rating of a tourist attraction, hotel, or restaurant." ;
                                          rdfs:label "Rating" .


###  https://noah.dev/ontologies/otir/StarRating
<https://noah.dev/ontologies/otir/StarRating> rdf:type owl:DatatypeProperty ;
                                              rdfs:domain <https://schema.org/Hotel> ;
                                              rdfs:range xsd:integer ;
                                              rdfs:comment "Specifies the star rating of a hotel." ;
                                              rdfs:label "Star Rating" .


#################################################################
#    Classes
#################################################################

###  http://www.w3.org/2002/07/owl#Thing
owl:Thing rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty <https://noah.dev/ontologies/otir/Name> ;
                            owl:minCardinality "1"^^xsd:nonNegativeInteger
                          ] .


###  https://noah.dev/ontologies/otir/AndalusianCuisine
<https://noah.dev/ontologies/otir/AndalusianCuisine> rdf:type owl:Class ;
                                                     rdfs:subClassOf <https://schema.org/Restaurant> ;
                                                     rdfs:comment "Restaurants specialized in Andalusian cuisine." ;
                                                     rdfs:label "Andalusian Cuisine" .


###  https://noah.dev/ontologies/otir/Beach
<https://noah.dev/ontologies/otir/Beach> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://schema.org/TouristAttraction> ;
                                         rdfs:comment "Tourist attraction related to beaches and coastal areas." ;
                                         rdfs:label "Beach" .


###  https://noah.dev/ontologies/otir/BeachHotel
<https://noah.dev/ontologies/otir/BeachHotel> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://schema.org/Hotel> ;
                                              rdfs:comment "Hotel located near the beach or with direct beach access." ;
                                              rdfs:label "Beach Hotel" .


###  https://noah.dev/ontologies/otir/BusinessHotel
<https://noah.dev/ontologies/otir/BusinessHotel> rdf:type owl:Class ;
                                                 rdfs:subClassOf <https://schema.org/Hotel> ;
                                                 rdfs:comment "Hotel oriented towards business travelers and corporate events." ;
                                                 rdfs:label "Business Hotel" .


###  https://noah.dev/ontologies/otir/Cultural
<https://noah.dev/ontologies/otir/Cultural> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://schema.org/TouristAttraction> ;
                                            rdfs:comment "Tourist attraction related to various cultural activities or spaces." ;
                                            rdfs:label "Cultural" .


###  https://noah.dev/ontologies/otir/CulturalEvent
<https://noah.dev/ontologies/otir/CulturalEvent> rdf:type owl:Class ;
                                                 rdfs:subClassOf <https://schema.org/Event> ;
                                                 rdfs:comment "Cultural events such as festivals, fairs, or performances." ;
                                                 rdfs:label "Cultural Event" .


###  https://noah.dev/ontologies/otir/GastronomicEvent
<https://noah.dev/ontologies/otir/GastronomicEvent> rdf:type owl:Class ;
                                                    rdfs:subClassOf <https://schema.org/Event> ;
                                                    rdfs:comment "Events related to gastronomy or food tasting." ;
                                                    rdfs:label "Gastronomic Event" .


###  https://noah.dev/ontologies/otir/ItalianCuisine
<https://noah.dev/ontologies/otir/ItalianCuisine> rdf:type owl:Class ;
                                                  rdfs:subClassOf <https://schema.org/Restaurant> ;
                                                  rdfs:comment "Restaurants specialized in Italian cuisine." ;
                                                  rdfs:label "Italian Cuisine" .


###  https://noah.dev/ontologies/otir/JapaneseCuisine
<https://noah.dev/ontologies/otir/JapaneseCuisine> rdf:type owl:Class ;
                                                   rdfs:subClassOf <https://schema.org/Restaurant> ;
                                                   rdfs:comment "Restaurants specialized in Japanese cuisine." ;
                                                   rdfs:label "Japanese Cuisine" .


###  https://noah.dev/ontologies/otir/LuxuryHotel
<https://noah.dev/ontologies/otir/LuxuryHotel> rdf:type owl:Class ;
                                               rdfs:subClassOf <https://schema.org/Hotel> ;
                                               rdfs:comment "High-end hotel offering luxury services." ;
                                               rdfs:label "Luxury Hotel" .


###  https://noah.dev/ontologies/otir/MediterraneanCuisine
<https://noah.dev/ontologies/otir/MediterraneanCuisine> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://schema.org/Restaurant> ;
                                                        rdfs:comment "Restaurants specialized in Mediterranean cuisine." ;
                                                        rdfs:label "Mediterranean Cuisine" .


###  https://noah.dev/ontologies/otir/MexicanCuisine
<https://noah.dev/ontologies/otir/MexicanCuisine> rdf:type owl:Class ;
                                                  rdfs:subClassOf <https://schema.org/Restaurant> ;
                                                  rdfs:comment "Restaurants specialized in Mexican cuisine." ;
                                                  rdfs:label "Mexican Cuisine" .


###  https://noah.dev/ontologies/otir/Monument
<https://noah.dev/ontologies/otir/Monument> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://schema.org/TouristAttraction> ;
                                            rdfs:comment "Historical or symbolic structure of cultural interest." ;
                                            rdfs:label "Monument" .


###  https://noah.dev/ontologies/otir/Museum
<https://noah.dev/ontologies/otir/Museum> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://schema.org/TouristAttraction> ;
                                          rdfs:comment "Tourist attraction focused on cultural or artistic exhibitions." ;
                                          rdfs:label "Museum" .


###  https://noah.dev/ontologies/otir/MusicEvent
<https://noah.dev/ontologies/otir/MusicEvent> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://schema.org/Event> ;
                                              rdfs:comment "Events centered around musical performances or concerts." ;
                                              rdfs:label "Music Event" .


###  https://noah.dev/ontologies/otir/Park
<https://noah.dev/ontologies/otir/Park> rdf:type owl:Class ;
                                        rdfs:subClassOf <https://schema.org/TouristAttraction> ;
                                        rdfs:comment "Green spaces intended for leisure and relaxation of visitors." ;
                                        rdfs:label "Park" .


###  https://noah.dev/ontologies/otir/RuralHotel
<https://noah.dev/ontologies/otir/RuralHotel> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://schema.org/Hotel> ;
                                              rdfs:comment "Hotel located in natural or rural environments." ;
                                              rdfs:label "Rural Hotel" .


###  https://noah.dev/ontologies/otir/SportEvent
<https://noah.dev/ontologies/otir/SportEvent> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://schema.org/Event> ;
                                              rdfs:comment "Events related to sports activities." ;
                                              rdfs:label "Sport Event" .


###  https://noah.dev/ontologies/otir/TechnologicalEvent
<https://noah.dev/ontologies/otir/TechnologicalEvent> rdf:type owl:Class ;
                                                      rdfs:subClassOf <https://schema.org/Event> ;
                                                      rdfs:comment "Events related to technology, innovation, or science." ;
                                                      rdfs:label "Technological Event" .


###  https://noah.dev/ontologies/otir/TouristicHotel
<https://noah.dev/ontologies/otir/TouristicHotel> rdf:type owl:Class ;
                                                  rdfs:subClassOf <https://schema.org/Hotel> ;
                                                  rdfs:comment "Hotel mainly aimed at leisure travelers." ;
                                                  rdfs:label "Touristic Hotel" .


###  https://schema.org/City
<https://schema.org/City> rdf:type owl:Class ;
                          rdfs:comment "Municipalities or geographic locations within the ontology." ;
                          rdfs:label "City" .


###  https://schema.org/Event
<https://schema.org/Event> rdf:type owl:Class ;
                           rdfs:subClassOf <https://schema.org/Place> ;
                           rdfs:comment "Activities or events that take place in a city and are intended for the public." ;
                           rdfs:label "Event" .


###  https://schema.org/Hotel
<https://schema.org/Hotel> rdf:type owl:Class ;
                           rdfs:subClassOf <https://schema.org/Place> ;
                           rdfs:comment "Establishments offering accommodation to travelers and tourists." ;
                           rdfs:label "Hotel" .


###  https://schema.org/Place
<https://schema.org/Place> rdf:type owl:Class ;
                           rdfs:subClassOf [ rdf:type owl:Restriction ;
                                             owl:onProperty <https://noah.dev/ontologies/otir/LocatedInCity> ;
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass <https://schema.org/City>
                                           ] ;
                           rdfs:comment "A general class representing any physical location, such as a hotel, restaurant, attraction, or event venue, which is associated with a specific city." ;
                           rdfs:label "Place" .


###  https://schema.org/Restaurant
<https://schema.org/Restaurant> rdf:type owl:Class ;
                                rdfs:subClassOf <https://schema.org/Place> ;
                                rdfs:comment "Establishments offering food and beverage services." ;
                                rdfs:label "Restaurant" .


###  https://schema.org/TouristAttraction
<https://schema.org/TouristAttraction> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://schema.org/Place> ;
                                       rdfs:comment "Tourist places of interest that can be visited by users." ;
                                       rdfs:label "Tourist Attraction" .


#################################################################
#    Individuals
#################################################################

###  https://noah.dev/ontologies/otir/Barcelona
<https://noah.dev/ontologies/otir/Barcelona> rdf:type owl:NamedIndividual ,
                                                      <https://schema.org/City> ;
                                             <https://noah.dev/ontologies/otir/Location> "41.3874,2.1686" ;
                                             <https://noah.dev/ontologies/otir/Name> "Barcelona" ;
                                             rdfs:comment "City of Barcelona, known for its architecture, culture, and Mediterranean coast." ;
                                             rdfs:label "Barcelona" .


###  https://noah.dev/ontologies/otir/Bilbao
<https://noah.dev/ontologies/otir/Bilbao> rdf:type owl:NamedIndividual ,
                                                   <https://schema.org/City> ;
                                          <https://noah.dev/ontologies/otir/HasLocation> <https://noah.dev/ontologies/otir/CongresBilbao> ,
                                                                                         <https://noah.dev/ontologies/otir/HotelRoyalBilbao> ;
                                          <https://noah.dev/ontologies/otir/Location> "43.2630,-2.9350" ;
                                          <https://noah.dev/ontologies/otir/Name> "Bilbao" ;
                                          rdfs:comment "City of Bilbao, famous for the Guggenheim Museum and Basque culture." ;
                                          rdfs:label "Bilbao" .


###  https://noah.dev/ontologies/otir/Cadis
<https://noah.dev/ontologies/otir/Cadis> rdf:type owl:NamedIndividual ,
                                                  <https://schema.org/City> ;
                                         <https://noah.dev/ontologies/otir/HasLocation> <https://noah.dev/ontologies/otir/CarnavalCadis> ,
                                                                                        <https://noah.dev/ontologies/otir/CastellCadis> ,
                                                                                        <https://noah.dev/ontologies/otir/CongresCadis> ;
                                         <https://noah.dev/ontologies/otir/Location> "36.5297,-6.2920" ;
                                         <https://noah.dev/ontologies/otir/Name> "Cadis" ;
                                         rdfs:comment "City of Cadis, a historic port city in southwestern Spain." ;
                                         rdfs:label "Cadis" .


###  https://noah.dev/ontologies/otir/CarnavalCadis
<https://noah.dev/ontologies/otir/CarnavalCadis> rdf:type owl:NamedIndividual ,
                                                          <https://noah.dev/ontologies/otir/SportEvent> ;
                                                 <https://noah.dev/ontologies/otir/Date> "2024-04-19"^^xsd:date ;
                                                 <https://noah.dev/ontologies/otir/Name> "Carnaval Cadis" ;
                                                 rdfs:comment "Event in Cadis, a traditional and colorful carnival celebration." ;
                                                 rdfs:label "Carnaval Cadis" .


###  https://noah.dev/ontologies/otir/CarnavalSevilla
<https://noah.dev/ontologies/otir/CarnavalSevilla> rdf:type owl:NamedIndividual ,
                                                            <https://noah.dev/ontologies/otir/MusicEvent> ;
                                                   <https://noah.dev/ontologies/otir/Date> "2024-05-08"^^xsd:date ;
                                                   <https://noah.dev/ontologies/otir/Name> "Carnaval Sevilla" ;
                                                   rdfs:comment "Event in Sevilla, a vibrant carnival featuring music and parades." ;
                                                   rdfs:label "Carnaval Sevilla" .


###  https://noah.dev/ontologies/otir/CastellCadis
<https://noah.dev/ontologies/otir/CastellCadis> rdf:type owl:NamedIndividual ,
                                                         <https://noah.dev/ontologies/otir/Beach> ;
                                                <https://noah.dev/ontologies/otir/Name> "Castell Cadis" ;
                                                <https://noah.dev/ontologies/otir/Rating> 3.5 ;
                                                rdfs:comment "Tourist attraction in Cadis, a historical castle near the coast." ;
                                                rdfs:label "Castell Cadis" .


###  https://noah.dev/ontologies/otir/CastellSaragossa
<https://noah.dev/ontologies/otir/CastellSaragossa> rdf:type owl:NamedIndividual ,
                                                             <https://noah.dev/ontologies/otir/Museum> ;
                                                    <https://noah.dev/ontologies/otir/Name> "Castell Saragossa" ;
                                                    <https://noah.dev/ontologies/otir/Rating> 5.0 ;
                                                    rdfs:comment "Tourist attraction in Saragossa, a historical castle open to visitors." ;
                                                    rdfs:label "Castell Saragossa" .


###  https://noah.dev/ontologies/otir/CastellSevilla
<https://noah.dev/ontologies/otir/CastellSevilla> rdf:type owl:NamedIndividual ,
                                                           <https://noah.dev/ontologies/otir/Monument> ;
                                                  <https://noah.dev/ontologies/otir/Name> "Castell Sevilla" ;
                                                  <https://noah.dev/ontologies/otir/Rating> 4.6 ;
                                                  rdfs:comment "Tourist attraction in Sevilla, a well-preserved historical castle." ;
                                                  rdfs:label "Castell Sevilla" .


###  https://noah.dev/ontologies/otir/CatedralSevilla
<https://noah.dev/ontologies/otir/CatedralSevilla> rdf:type owl:NamedIndividual ,
                                                            <https://noah.dev/ontologies/otir/Museum> ;
                                                   <https://noah.dev/ontologies/otir/Name> "Catedral Sevilla" ;
                                                   <https://noah.dev/ontologies/otir/Rating> 4.9 ;
                                                   rdfs:comment "Tourist attraction in Sevilla, a cultural and historical palace." ;
                                                   rdfs:label "Catedral Sevilla" .


###  https://noah.dev/ontologies/otir/CongresBilbao
<https://noah.dev/ontologies/otir/CongresBilbao> rdf:type owl:NamedIndividual ,
                                                          <https://noah.dev/ontologies/otir/CulturalEvent> ;
                                                 <https://noah.dev/ontologies/otir/Date> "2024-12-01"^^xsd:date ;
                                                 <https://noah.dev/ontologies/otir/Name> "Congrés Bilbao" ;
                                                 rdfs:comment "Event in Bilbao, a conference with a cultural theme." ;
                                                 rdfs:label "Congres Bilbao" .


###  https://noah.dev/ontologies/otir/CongresCadis
<https://noah.dev/ontologies/otir/CongresCadis> rdf:type owl:NamedIndividual ,
                                                         <https://noah.dev/ontologies/otir/SportEvent> ;
                                                <https://noah.dev/ontologies/otir/Date> "2024-06-02"^^xsd:date ;
                                                <https://noah.dev/ontologies/otir/Name> "Congrés Cadis" ;
                                                rdfs:comment "Event in Cadis, a congress related to sports activities." ;
                                                rdfs:label "Congres Cadis" .


###  https://noah.dev/ontologies/otir/FiraToledo
<https://noah.dev/ontologies/otir/FiraToledo> rdf:type owl:NamedIndividual ,
                                                       <https://noah.dev/ontologies/otir/SportEvent> ;
                                              <https://noah.dev/ontologies/otir/Date> "2024-08-26"^^xsd:date ;
                                              <https://noah.dev/ontologies/otir/Name> "Fira Toledo" ;
                                              rdfs:comment "Event in Toledo, a fair related to local traditions and sports." ;
                                              rdfs:label "Fira Toledo" .


###  https://noah.dev/ontologies/otir/HotelDelMarSevilla
<https://noah.dev/ontologies/otir/HotelDelMarSevilla> rdf:type owl:NamedIndividual ,
                                                               <https://noah.dev/ontologies/otir/TouristicHotel> ;
                                                      <https://noah.dev/ontologies/otir/Name> "Hotel Del Mar Sevilla" ;
