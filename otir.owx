    <DLSafeRule>
        <Annotation>
            <AnnotationProperty IRI="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
            <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#boolean">true</Literal>
        </Annotation>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
            <Literal>Rule that assigns the best hotel of the city. If the hotel is the only one in the city, it doesn&apos;t count.</Literal>
        </Annotation>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:label"/>
            <Literal>BestHotelRule</Literal>
        </Annotation>
        <Body>
            <ClassAtom>
                <Class abbreviatedIRI="schema:Hotel"/>
                <Variable IRI="/H1"/>
            </ClassAtom>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="/LocatedInCity"/>
                <Variable IRI="/H1"/>
                <Variable IRI="/C"/>
            </ObjectPropertyAtom>
            <DataPropertyAtom>
                <DataProperty IRI="/Rating"/>
                <Variable IRI="/H1"/>
                <Variable IRI="/R1"/>
            </DataPropertyAtom>
            <ClassAtom>
                <Class abbreviatedIRI="schema:Hotel"/>
                <Variable IRI="/H2"/>
            </ClassAtom>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="/LocatedInCity"/>
                <Variable IRI="/H2"/>
                <Variable IRI="/C"/>
            </ObjectPropertyAtom>
            <DataPropertyAtom>
                <DataProperty IRI="/Rating"/>
                <Variable IRI="/H2"/>
                <Variable IRI="/R2"/>
            </DataPropertyAtom>
            <BuiltInAtom abbreviatedIRI="swrlb:greaterThan">
                <Variable IRI="/R1"/>
                <Variable IRI="/R2"/>
            </BuiltInAtom>
        </Body>
        <Head>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="/BestHotel"/>
                <Variable IRI="/H1"/>
                <Variable IRI="/C"/>
            </ObjectPropertyAtom>
        </Head>
    </DLSafeRule>
    <DLSafeRule>
        <Annotation>
            <AnnotationProperty IRI="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
            <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#boolean">true</Literal>
        </Annotation>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
            <Literal>Rule that indicates the rest of the places in the same city as the consulted place.</Literal>
        </Annotation>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:label"/>
            <Literal>SameCityRule</Literal>
        </Annotation>
        <Body>
            <ClassAtom>
                <Class abbreviatedIRI="schema:Place"/>
                <Variable IRI="/P1"/>
            </ClassAtom>
            <ClassAtom>
                <Class abbreviatedIRI="schema:Place"/>
                <Variable IRI="/P2"/>
            </ClassAtom>
            <DataPropertyAtom>
                <DataProperty IRI="/Name"/>
                <Variable IRI="/P1"/>
                <Variable IRI="/N1"/>
            </DataPropertyAtom>
            <DataPropertyAtom>
                <DataProperty IRI="/Name"/>
                <Variable IRI="/P2"/>
                <Variable IRI="/N2"/>
            </DataPropertyAtom>
            <BuiltInAtom abbreviatedIRI="swrlb:notEqual">
                <Variable IRI="/N1"/>
                <Variable IRI="/N2"/>
            </BuiltInAtom>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="/LocatedInCity"/>
                <Variable IRI="/P1"/>
                <Variable IRI="/C"/>
            </ObjectPropertyAtom>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="/LocatedInCity"/>
                <Variable IRI="/P2"/>
                <Variable IRI="/C"/>
            </ObjectPropertyAtom>
        </Body>
        <Head>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="/SameCity"/>
                <Variable IRI="/P1"/>
                <Variable IRI="/P2"/>
            </ObjectPropertyAtom>
        </Head>
    </DLSafeRule>
    <DLSafeRule>
        <Annotation>
            <AnnotationProperty IRI="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
            <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#boolean">true</Literal>
        </Annotation>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
            <Literal>Rule that assigns the best tourist attraction of the city. If the attraction is the only one in city, it doesn&apos;t count.</Literal>
        </Annotation>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:label"/>
            <Literal>BestTouristAttractionRule</Literal>
        </Annotation>
        <Body>
